{
  "board": {
    ".gitignore": {
      "lines": [
        "# Ephemeral Lattice runtime state — not part of the durable board.",
        "# The board (tasks/ events/ plans/ artifacts/ ids.json config.json)",
        "# stays tracked: it is the audit log and cross-machine coordination",
        "# state. The paths below are mutated constantly and must never",
        "# diverge per-worktree or collide on merge.",
        "review_state/",
        "tmp-prompts/",
        ".daemon/",
        "locks/"
      ]
    },
    "config.json": {
      "json": {
        "auto_code_review_on_transition": false,
        "auto_plan_review_on_transition": false,
        "dashboard": {
          "column_width": 320,
          "day_start_hour": 6,
          "done_display": "recent",
          "font_size": 14,
          "heat_map_enabled": true,
          "lane_colors": {
            "backlog": "#123456"
          },
          "lane_sort": {
            "backlog": "priority"
          },
          "max_items_per_column": 25,
          "theme": "light",
          "voice": "calm"
        },
        "default_actor": "human:parity",
        "default_priority": "medium",
        "default_status": "backlog",
        "done_display": "grouped",
        "instance_id": "<ID-1>",
        "plan_approval": "auto",
        "plan_review_mode": "single",
        "project_code": "PAR",
        "review_max_diff_chars": 120000,
        "review_max_diff_lines": 5000,
        "review_mode": "single",
        "review_timeout_seconds": 600,
        "schema_version": 1,
        "status_preset": "stage11",
        "task_types": [
          "task",
          "bug",
          "spike",
          "chore"
        ],
        "workflow": {
          "completion_policies": {
            "done": {
              "require_roles": [
                "review"
              ]
            },
            "pr_open": {
              "require_roles": [
                "validation"
              ]
            }
          },
          "descriptions": {
            "backlog": "Task is captured but no work has started. No planning, no implementation.",
            "blocked": "Work cannot proceed due to an external dependency or unresolved issue.",
            "cancelled": "Work has been abandoned. No further action will be taken.",
            "done": "Work is reviewed, merged, and shipped. No further action needed.",
            "in_planning": "Design, dialogue, and scoping underway. No implementation code should be written yet.",
            "in_progress": "Implementation is actively underway. Code is being written, tested, or integrated.",
            "in_validation": "End-to-end validation is underway. The change is being exercised against a running system — browser automation, simulator flows, curl — before the PR opens. The bar: 'I saw it work,' not 'I think it should work.'",
            "planned": "Plan is written and approved. Ready for implementation but work has not started.",
            "pr_open": "PR is open and awaiting human review, CI, or merge. Local review and validation artifacts are recorded.",
            "review": "Local review is underway. A review sub-agent is examining the diff before validation begins."
          },
          "roles": [
            "review",
            "plan-review",
            "review-individual",
            "validation"
          ],
          "statuses": [
            "backlog",
            "in_planning",
            "planned",
            "in_progress",
            "review",
            "in_validation",
            "pr_open",
            "done",
            "blocked",
            "cancelled"
          ],
          "transitions": {
            "backlog": [
              "in_planning",
              "planned",
              "cancelled"
            ],
            "blocked": [
              "in_planning",
              "planned",
              "in_progress",
              "in_validation",
              "pr_open",
              "cancelled"
            ],
            "cancelled": [],
            "done": [],
            "in_planning": [
              "planned",
              "cancelled"
            ],
            "in_progress": [
              "review",
              "blocked",
              "cancelled"
            ],
            "in_validation": [
              "pr_open",
              "in_progress",
              "in_planning",
              "blocked",
              "cancelled"
            ],
            "planned": [
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "pr_open": [
              "done",
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "review": [
              "in_validation",
              "pr_open",
              "done",
              "in_progress",
              "in_planning",
              "cancelled"
            ]
          },
          "universal_targets": [
            "cancelled"
          ],
          "wip_limits": {
            "in_progress": 10,
            "in_validation": 5,
            "pr_open": 10,
            "review": 5
          }
        },
        "workflow_preset": "classic"
      }
    },
    "context.md": {
      "lines": [
        "# Instance Context",
        "",
        "<!-- Every lattice instance exists for a reason — a convergence of intention",
        "     and infrastructure. This file declares that reason. Agents and humans",
        "     read it to understand the purpose, conventions, and relationships",
        "     of this particular node in the lattice. -->",
        "",
        "## Purpose",
        "",
        "<!-- What does this instance observe? What project, team, or domain",
        "     does it serve? Declare the scope of attention. -->",
        "",
        "## Related Instances",
        "",
        "<!-- If this node coordinates with other lattice instances, name them here.",
        "     Include instance_id, instance_name, and the nature of the relationship.",
        "     The lattice is stronger when its nodes are aware of each other. -->",
        "",
        "## Conventions",
        "",
        "<!-- Every instance develops its own rhythms — workflow conventions,",
        "     naming patterns, status meanings that diverge from defaults.",
        "     Record them here so that new minds arriving in this context",
        "     can orient immediately. -->"
      ]
    },
    "events/_lifecycle.jsonl": {
      "jsonl": []
    },
    "ids.json": {
      "json": {
        "map": {},
        "next_seqs": {},
        "schema_version": 2
      }
    }
  },
  "description": "the dashboard settings POST through the in-process dashboard server",
  "mode": "plain",
  "scenario": "dashboard_settings",
  "steps": [
    {
      "args": [
        "init",
        "--path",
        "<ROOT>",
        "--actor",
        "human:parity",
        "--project-code",
        "PAR",
        "--no-setup-claude",
        "--no-setup-agents",
        "--no-seed"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "",
          ".lattice/ created — a mind now has a place to remember.",
          "Default actor: human:parity",
          "Project code: PAR",
          "Workflow statuses: stage11 (10 statuses)"
        ]
      }
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "column_width": 320,
        "day_start_hour": 6,
        "done_display": "recent",
        "font_size": 14,
        "heat_map_enabled": true,
        "lane_colors": {
          "backlog": "#123456"
        },
        "lane_sort": {
          "backlog": "priority"
        },
        "max_items_per_column": 25,
        "theme": "dark",
        "voice": "calm"
      },
      "response": {
        "json": {
          "data": {
            "column_width": 320,
            "day_start_hour": 6,
            "done_display": "recent",
            "font_size": 14,
            "heat_map_enabled": true,
            "lane_colors": {
              "backlog": "#123456"
            },
            "lane_sort": {
              "backlog": "priority"
            },
            "max_items_per_column": 25,
            "theme": "dark",
            "voice": "calm"
          },
          "ok": true
        }
      },
      "status": 200
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "voice": true
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "'voice' must be a string"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "background_image": null,
        "theme": "light"
      },
      "response": {
        "json": {
          "data": {
            "column_width": 320,
            "day_start_hour": 6,
            "done_display": "recent",
            "font_size": 14,
            "heat_map_enabled": true,
            "lane_colors": {
              "backlog": "#123456"
            },
            "lane_sort": {
              "backlog": "priority"
            },
            "max_items_per_column": 25,
            "theme": "light",
            "voice": "calm"
          },
          "ok": true
        }
      },
      "status": 200
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "unknown_key": 1
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "Unknown keys: unknown_key"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "lane_colors": [
          "not",
          "an",
          "object"
        ]
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "'lane_colors' must be an object"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "lane_sort": {
          "backlog": 3
        }
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "lane_sort keys and values must be strings"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "theme": 7
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "'theme' must be a string or null"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": {
        "background_image": 7
      },
      "response": {
        "json": {
          "error": {
            "code": "VALIDATION_ERROR",
            "message": "'background_image' must be a string or null"
          },
          "ok": false
        }
      },
      "status": 400
    },
    {
      "post": "/api/config/dashboard",
      "request": "not json",
      "response": {
        "json": {
          "error": {
            "code": "BAD_REQUEST",
            "message": "Invalid JSON in request body"
          },
          "ok": false
        }
      },
      "status": 400
    }
  ]
}
