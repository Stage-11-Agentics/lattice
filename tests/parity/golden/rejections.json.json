    "ids.json": {
      "json": {
        "map": {
          "PAR-1": "<ID-1>"
        },
        "next_seqs": {
          "PAR": 2
        },
        "schema_version": 2
      }
    },
    "plans/<ID-1>.md": {
      "lines": [
        "# PAR-1: Waited on"
      ]
    },
    "tasks/<ID-1>.json": {
      "json": {
        "acceptance_criteria": [],
        "assigned_to": "human:parity",
        "branch_links": [],
        "comment_count": 0,
        "complexity": null,
        "created_at": "<TS>",
        "created_by": "human:parity",
        "custom_fields": {},
