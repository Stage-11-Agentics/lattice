        "short_id": "PAR-1",
        "status": "in_planning",
        "tags": null,
        "title": "Waited on",
        "type": "task",
        "updated_at": "<TS>",
        "urgency": null
      }
    }
  },
  "description": "rejection codes not reached elsewhere: uninitialized root, wait, surfaces",
