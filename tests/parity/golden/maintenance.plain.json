        "last_event_id": "<ID-6>",
        "last_status_changed_at": "<TS>",
        "linked_files": [],
        "priority": "medium",
        "relationships_out": [],
        "reopened_count": 0,
        "schema_version": 1,
        "short_id": "PAR-1",
        "status": "backlog",
