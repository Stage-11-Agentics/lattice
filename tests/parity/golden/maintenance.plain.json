  },
  "description": "local-only maintenance commands: rebuild, doctor, backfill-ids, migrate",
  "mode": "plain",
  "scenario": "maintenance",
  "steps": [
    {
      "args": [
        "init",
        "--path",
        "<ROOT>",
        "--actor",
        "human:parity",
        "--project-code",
        "PAR",
        "--no-setup-claude",
        "--no-setup-agents",
        "--no-seed"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "",
          ".lattice/ created — a mind now has a place to remember.",
          "Default actor: human:parity",
          "Project code: PAR",
          "Workflow statuses: stage11 (10 statuses)"
        ]
      }
    },
    {
      "args": [
        "create",
        "Maintained one",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Created task PAR-1 (<ID-1>) \"Maintained one\"",
          "  status: backlog  priority: medium  type: task"
        ]
      }
    },
    {
      "args": [
        "create",
        "Maintained two",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Created task PAR-2 (<ID-2>) \"Maintained two\"",
          "  status: backlog  priority: medium  type: task"
        ]
      }
    },
    {
      "args": [
        "comment",
        "PAR-1",
        "Some history",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Comment added to <ID-1>"
        ]
      }
    },
    {
      "args": [
        "rebuild",
        "PAR-1"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: No event log found for PAR-1."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "rebuild",
        "<ID-1>"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Rebuilt <ID-1>"
        ]
      }
    },
    {
      "args": [
        "rebuild",
        "--all"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Rebuilt 2 tasks, regenerated lifecycle log"
        ]
      }
    },
    {
      "args": [
        "rebuild"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Provide a task ID or use --all."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "doctor"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Checking 2 tasks, 3 events, 0 artifacts...",
          "✓ All JSON files valid",
          "✓ All JSONL files valid",
          "✓ All snapshots consistent with event logs",
          "✓ All relationship targets exist",
          "✓ All artifact references valid",
          "✓ No self-links",
          "✓ No duplicate edges",
          "✓ All IDs well-formed",
          "✓ Lifecycle log consistent",
          "✓ Short ID aliases consistent",
          "",
          "No issues found."
        ]
      }
    },
    {
      "args": [
        "doctor",
        "--fix"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Checking 2 tasks, 3 events, 0 artifacts...",
          "✓ All JSON files valid",
          "✓ All JSONL files valid",
          "✓ All snapshots consistent with event logs",
          "✓ All relationship targets exist",
          "✓ All artifact references valid",
          "✓ No self-links",
          "✓ No duplicate edges",
          "✓ All IDs well-formed",
          "✓ Lifecycle log consistent",
          "✓ Short ID aliases consistent",
          "",
          "No issues found."
        ]
      }
    },
    {
      "args": [
        "backfill-ids"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "All tasks already have short IDs."
        ]
      }
    },
    {
      "args": [
        "migrate",
        "needs-human",
        "--dry-run"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "[dry-run] Nothing to migrate — instance already uses the needs_human flag."
        ]
      }
    },
    {
      "args": [
        "migrate",
        "needs-human",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Nothing to migrate — instance already uses the needs_human flag."
        ]
      }
    },
    {
      "write_file": ".lattice/events/<ID-2>.jsonl"
    },
    {
      "args": [
        "rebuild",
        "<ID-2>"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: <ROOT>/.lattice/events/<ID-2>.jsonl: invalid JSONL record: Expecting property name enclosed in double quotes: line 1 column 2 (char 1) (line 1)"
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "rebuild",
        "--all"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Rebuild refused malformed or divergent authority: Authoritative log error for <ID-2>: <ROOT>/.lattice/events/<ID-2>.jsonl: invalid JSONL record: Expecting property name enclosed in double quotes: line 1 column 2 (char 1) (line 1). Rebuild will refuse to overwrite data; manual recovery is required.; <ID-2>: no valid authoritative event log"
        ]
      },
      "stdout": {
        "lines": []
      }
    }
  ]
}
