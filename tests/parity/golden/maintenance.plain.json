        "map": {
          "PAR-1": "<ID-1>",
          "PAR-2": "<ID-2>"
        },
        "next_seqs": {
          "PAR": 3
        },
        "schema_version": 2
      }
    },
    "plans/<ID-1>.md": {
      "lines": [
        "# PAR-1: Maintained one"
      ]
    },
    "plans/<ID-2>.md": {
      "lines": [
        "# PAR-2: Maintained two"
      ]
    },
    "tasks/<ID-1>.json": {
      "json": {
        "acceptance_criteria": [],
        "assigned_to": null,
        "branch_links": [],
        "comment_count": 1,
        "complexity": null,
        "created_at": "<TS>",
        "created_by": "human:parity",
        "custom_fields": {},
