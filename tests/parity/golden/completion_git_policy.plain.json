{
  "board": {
    ".gitignore": {
      "lines": [
        "# Ephemeral Lattice runtime state — not part of the durable board.",
        "# The board (tasks/ events/ plans/ artifacts/ ids.json config.json)",
        "# stays tracked: it is the audit log and cross-machine coordination",
        "# state. The paths below are mutated constantly and must never",
        "# diverge per-worktree or collide on merge.",
        "review_state/",
        "tmp-prompts/",
        ".daemon/",
        "locks/"
      ]
    },
    "config.json": {
      "json": {
        "auto_code_review_on_transition": false,
        "auto_plan_review_on_transition": false,
        "default_actor": "human:parity",
        "default_priority": "medium",
        "default_status": "backlog",
        "done_display": "grouped",
        "instance_id": "<ID-2>",
        "plan_approval": "auto",
        "plan_review_mode": "single",
        "project_code": "PAR",
        "review_max_diff_chars": 120000,
        "review_max_diff_lines": 5000,
        "review_mode": "single",
        "review_timeout_seconds": 600,
        "schema_version": 1,
        "status_preset": "stage11",
        "task_types": [
          "task",
          "bug",
          "spike",
          "chore"
        ],
        "workflow": {
          "completion_policies": {
            "done": {
              "require_reachable_review_commit": true,
              "require_roles": [
                "review"
              ]
            },
            "pr_open": {
              "require_roles": [
                "validation"
              ]
            }
          },
          "descriptions": {
            "backlog": "Task is captured but no work has started. No planning, no implementation.",
            "blocked": "Work cannot proceed due to an external dependency or unresolved issue.",
            "cancelled": "Work has been abandoned. No further action will be taken.",
            "done": "Work is reviewed, merged, and shipped. No further action needed.",
            "in_planning": "Design, dialogue, and scoping underway. No implementation code should be written yet.",
            "in_progress": "Implementation is actively underway. Code is being written, tested, or integrated.",
            "in_validation": "End-to-end validation is underway. The change is being exercised against a running system — browser automation, simulator flows, curl — before the PR opens. The bar: 'I saw it work,' not 'I think it should work.'",
            "planned": "Plan is written and approved. Ready for implementation but work has not started.",
            "pr_open": "PR is open and awaiting human review, CI, or merge. Local review and validation artifacts are recorded.",
            "review": "Local review is underway. A review sub-agent is examining the diff before validation begins."
          },
          "roles": [
            "review",
            "plan-review",
            "review-individual",
            "validation"
          ],
          "statuses": [
            "backlog",
            "in_planning",
            "planned",
            "in_progress",
            "review",
            "in_validation",
            "pr_open",
            "done",
            "blocked",
            "cancelled"
          ],
          "transitions": {
            "backlog": [
              "in_planning",
              "planned",
              "cancelled"
            ],
            "blocked": [
              "in_planning",
              "planned",
              "in_progress",
              "in_validation",
              "pr_open",
              "cancelled"
            ],
            "cancelled": [],
            "done": [],
            "in_planning": [
              "planned",
              "cancelled"
            ],
            "in_progress": [
              "review",
              "blocked",
              "cancelled"
            ],
            "in_validation": [
              "pr_open",
              "in_progress",
              "in_planning",
              "blocked",
              "cancelled"
            ],
            "planned": [
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "pr_open": [
              "done",
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "review": [
              "in_validation",
              "pr_open",
              "done",
              "in_progress",
              "in_planning",
              "cancelled"
            ]
          },
          "universal_targets": [
            "cancelled"
          ],
          "wip_limits": {
            "in_progress": 10,
            "in_validation": 5,
            "pr_open": 10,
            "review": 5
          }
        },
        "workflow_preset": "classic"
      }
    },
    "context.md": {
      "lines": [
        "# Instance Context",
        "",
        "<!-- Every lattice instance exists for a reason — a convergence of intention",
        "     and infrastructure. This file declares that reason. Agents and humans",
        "     read it to understand the purpose, conventions, and relationships",
        "     of this particular node in the lattice. -->",
        "",
        "## Purpose",
        "",
        "<!-- What does this instance observe? What project, team, or domain",
        "     does it serve? Declare the scope of attention. -->",
        "",
        "## Related Instances",
        "",
        "<!-- If this node coordinates with other lattice instances, name them here.",
        "     Include instance_id, instance_name, and the nature of the relationship.",
        "     The lattice is stronger when its nodes are aware of each other. -->",
        "",
        "## Conventions",
        "",
        "<!-- Every instance develops its own rhythms — workflow conventions,",
        "     naming patterns, status meanings that diverge from defaults.",
        "     Record them here so that new minds arriving in this context",
        "     can orient immediately. -->"
      ]
    },
    "events/<ID-1>.jsonl": {
      "jsonl": [
        {
          "actor": "human:parity",
          "data": {
            "priority": "medium",
            "short_id": "PAR-1",
            "status": "backlog",
            "title": "Git gated",
            "type": "task"
          },
          "id": "<ID-3>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "task_created"
        },
        {
          "actor": "human:parity",
          "data": {
            "from": null,
            "to": "human:parity"
          },
          "id": "<ID-4>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "assignment_changed"
        },
        {
          "actor": "human:parity",
          "data": {
            "force": true,
            "from": "backlog",
            "reason": "straight to work",
            "to": "in_progress"
          },
          "id": "<ID-5>",
          "provenance": {
            "reason": "straight to work"
          },
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "status_changed"
        },
        {
          "actor": "human:parity",
          "data": {
            "from": "in_progress",
            "to": "review"
          },
          "id": "<ID-6>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "status_changed"
        },
        {
          "actor": "human:parity",
          "data": {
            "body": "Reviewed.",
            "role": "review"
          },
          "id": "<ID-7>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "comment_added"
        }
      ]
    },
    "events/_lifecycle.jsonl": {
      "jsonl": [
        {
          "actor": "human:parity",
          "data": {
            "priority": "medium",
            "short_id": "PAR-1",
            "status": "backlog",
            "title": "Git gated",
            "type": "task"
          },
          "id": "<ID-3>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "task_created"
        }
      ]
    },
    "ids.json": {
      "json": {
        "map": {
          "PAR-1": "<ID-1>"
        },
        "next_seqs": {
          "PAR": 2
        },
        "schema_version": 2
      }
    },
    "plans/<ID-1>.md": {
      "lines": [
        "# PAR-1: Git gated"
      ]
    },
    "tasks/<ID-1>.json": {
      "json": {
        "acceptance_criteria": [],
        "assigned_to": "human:parity",
        "branch_links": [],
        "comment_count": 1,
        "complexity": null,
        "created_at": "<TS>",
        "created_by": "human:parity",
        "custom_fields": {},
        "description": null,
        "done_at": null,
        "evidence_refs": [
          {
            "id": "<ID-7>",
            "role": "review",
            "source_type": "comment"
          }
        ],
        "id": "<ID-1>",
        "last_event_id": "<ID-7>",
        "last_status_changed_at": "<TS>",
        "linked_files": [],
        "priority": "medium",
        "relationships_out": [],
        "reopened_count": 0,
        "schema_version": 1,
        "short_id": "PAR-1",
        "status": "review",
        "tags": null,
        "title": "Git gated",
        "type": "task",
        "updated_at": "<TS>",
        "urgency": null
      }
    }
  },
  "description": "require_reachable_review_commit refuses completion outside a git worktree",
  "mode": "plain",
  "scenario": "completion_git_policy",
  "steps": [
    {
      "args": [
        "init",
        "--path",
        "<ROOT>",
        "--actor",
        "human:parity",
        "--project-code",
        "PAR",
        "--no-setup-claude",
        "--no-setup-agents",
        "--no-seed"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "",
          ".lattice/ created — a mind now has a place to remember.",
          "Default actor: human:parity",
          "Project code: PAR",
          "Workflow statuses: stage11 (10 statuses)"
        ]
      }
    },
    {
      "args": [
        "create",
        "Git gated",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Created task PAR-1 (<ID-1>) \"Git gated\"",
          "  status: backlog  priority: medium  type: task"
        ]
      }
    },
    {
      "args": [
        "status",
        "PAR-1",
        "in_progress",
        "--force",
        "--reason",
        "straight to work",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Status: backlog -> in_progress (PAR-1)  (auto-assigned to human:parity)",
          "  Next: implement the plan, then move to review."
        ]
      }
    },
    {
      "args": [
        "complete",
        "PAR-1",
        "--review",
        "Reviewed.",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Not inside a git worktree."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "status",
        "PAR-1",
        "review",
        "--no-auto-review",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Status: in_progress -> review (PAR-1)",
          "  Next: run 'lattice code-review PAR-1' (review_mode: single) before moving to in_validation. (auto-review skipped (reviewed_worktree_unavailable))"
        ]
      }
    },
    {
      "args": [
        "comment",
        "PAR-1",
        "Reviewed.",
        "--role",
        "review",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Comment added to <ID-1>"
        ]
      }
    },
    {
      "args": [
        "status",
        "PAR-1",
        "done",
        "--actor",
        "human:parity"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Completion policy not satisfied: Reachable review commit check requires repository context. Override with --force --reason."
        ]
      },
      "stdout": {
        "lines": []
      }
    }
  ]
}
