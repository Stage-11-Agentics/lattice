  "description": "set-project-code and set-subproject-code (no --json: plain run only)",
  "mode": "plain",
  "scenario": "project_codes",
  "steps": [
    {
      "args": [
        "init",
        "--path",
        "<ROOT>",
        "--actor",
        "human:parity",
        "--project-code",
        "PAR",
        "--no-setup-claude",
        "--no-setup-agents",
        "--no-seed"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "",
          ".lattice/ created — a mind now has a place to remember.",
          "Default actor: human:parity",
          "Project code: PAR",
          "Workflow statuses: stage11 (10 statuses)"
        ]
      }
    },
    {
      "args": [
        "create",
        "Before rename",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Created task PAR-1 (<ID-1>) \"Before rename\"",
          "  status: backlog  priority: medium  type: task"
        ]
      }
    },
    {
      "args": [
        "set-project-code",
        "NEW"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Project code is already set to 'PAR'. Use --force to change it."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "set-project-code",
        "NEW",
        "--force"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Project code set to NEW."
        ]
      }
    },
    {
      "args": [
        "set-project-code",
        "bad code!",
        "--force"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Invalid project code: 'BAD CODE!'. Must be 1-5 uppercase ASCII letters/digits, starting with a letter."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
