{
  "board": {
    ".gitignore": {
      "lines": [
        "# Ephemeral Lattice runtime state — not part of the durable board.",
        "# The board (tasks/ events/ plans/ artifacts/ ids.json config.json)",
        "# stays tracked: it is the audit log and cross-machine coordination",
        "# state. The paths below are mutated constantly and must never",
        "# diverge per-worktree or collide on merge.",
        "review_state/",
        "tmp-prompts/",
        ".daemon/",
        "locks/"
      ]
    },
    "config.json": {
      "json": {
        "auto_code_review_on_transition": false,
        "auto_plan_review_on_transition": false,
        "default_actor": "human:parity",
        "default_priority": "medium",
        "default_status": "backlog",
        "done_display": "grouped",
        "instance_id": "<ID-2>",
        "plan_approval": "auto",
        "plan_review_mode": "single",
        "project_code": "PAR",
        "review_max_diff_chars": 120000,
        "review_max_diff_lines": 5000,
        "review_mode": "single",
        "review_timeout_seconds": 600,
        "schema_version": 1,
        "status_preset": "stage11",
        "task_types": [
          "task",
          "bug",
          "chore"
        ],
        "workflow": {
          "completion_policies": {
            "done": {
              "require_roles": [
                "review"
              ]
            },
            "pr_open": {
              "require_roles": [
                "validation"
              ]
            }
          },
          "descriptions": {
            "backlog": "Task is captured but no work has started. No planning, no implementation.",
            "blocked": "Work cannot proceed due to an external dependency or unresolved issue.",
            "cancelled": "Work has been abandoned. No further action will be taken.",
            "done": "Work is reviewed, merged, and shipped. No further action needed.",
            "in_planning": "Design, dialogue, and scoping underway. No implementation code should be written yet.",
            "in_progress": "Implementation is actively underway. Code is being written, tested, or integrated.",
            "in_validation": "End-to-end validation is underway. The change is being exercised against a running system — browser automation, simulator flows, curl — before the PR opens. The bar: 'I saw it work,' not 'I think it should work.'",
            "planned": "Plan is written and approved. Ready for implementation but work has not started.",
            "pr_open": "PR is open and awaiting human review, CI, or merge. Local review and validation artifacts are recorded.",
            "review": "Local review is underway. A review sub-agent is examining the diff before validation begins."
          },
          "roles": [
            "review",
            "plan-review",
            "review-individual",
            "validation"
          ],
          "statuses": [
            "backlog",
            "in_planning",
            "planned",
            "in_progress",
            "review",
            "in_validation",
            "pr_open",
            "done",
            "blocked",
            "cancelled"
          ],
          "transitions": {
            "backlog": [
              "in_planning",
              "planned",
              "cancelled"
            ],
            "blocked": [
              "in_planning",
              "planned",
              "in_progress",
              "in_validation",
              "pr_open",
              "cancelled"
            ],
            "cancelled": [],
            "done": [],
            "in_planning": [
              "planned",
              "cancelled"
            ],
            "in_progress": [
              "review",
              "blocked",
              "cancelled"
            ],
            "in_validation": [
              "pr_open",
              "in_progress",
              "in_planning",
              "blocked",
              "cancelled"
            ],
            "planned": [
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "pr_open": [
              "done",
              "in_progress",
              "review",
              "blocked",
              "cancelled"
            ],
            "review": [
              "in_validation",
              "pr_open",
              "done",
              "in_progress",
              "in_planning",
              "cancelled"
            ]
          },
          "universal_targets": [
            "cancelled"
          ],
          "wip_limits": {
            "in_progress": 10,
            "in_validation": 5,
            "pr_open": 10,
            "review": 5
          }
        },
        "workflow_preset": "classic"
      }
    },
    "context.md": {
      "lines": [
        "# Instance Context",
        "",
        "<!-- Every lattice instance exists for a reason — a convergence of intention",
        "     and infrastructure. This file declares that reason. Agents and humans",
        "     read it to understand the purpose, conventions, and relationships",
        "     of this particular node in the lattice. -->",
        "",
        "## Purpose",
        "",
        "<!-- What does this instance observe? What project, team, or domain",
        "     does it serve? Declare the scope of attention. -->",
        "",
        "## Related Instances",
        "",
        "<!-- If this node coordinates with other lattice instances, name them here.",
        "     Include instance_id, instance_name, and the nature of the relationship.",
        "     The lattice is stronger when its nodes are aware of each other. -->",
        "",
        "## Conventions",
        "",
        "<!-- Every instance develops its own rhythms — workflow conventions,",
        "     naming patterns, status meanings that diverge from defaults.",
        "     Record them here so that new minds arriving in this context",
        "     can orient immediately. -->"
      ]
    },
    "events/<ID-1>.jsonl": {
      "jsonl": [
        {
          "actor": "human:parity",
          "data": {
            "priority": "medium",
            "short_id": "PAR-1",
            "status": "backlog",
            "title": "Flagged task",
            "type": "task"
          },
          "id": "<ID-3>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "task_created"
        },
        {
          "actor": "agent:worker",
          "data": {
            "reason": "Need a call on the schema"
          },
          "id": "<ID-4>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "needs_human_flagged"
        },
        {
          "actor": "human:parity",
          "data": {
            "note": "Decided: dual-write"
          },
          "id": "<ID-5>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "needs_human_cleared"
        },
        {
          "actor": "agent:worker",
          "data": {
            "reason": "A long reason\n\nwith `backticks`."
          },
          "id": "<ID-6>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "needs_human_flagged"
        },
        {
          "actor": "human:parity",
          "data": {
            "note": null
          },
          "id": "<ID-7>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "needs_human_cleared"
        }
      ]
    },
    "events/_lifecycle.jsonl": {
      "jsonl": [
        {
          "actor": "human:parity",
          "data": {
            "priority": "medium",
            "short_id": "PAR-1",
            "status": "backlog",
            "title": "Flagged task",
            "type": "task"
          },
          "id": "<ID-3>",
          "schema_version": 1,
          "task_id": "<ID-1>",
          "ts": "<TS>",
          "type": "task_created"
        }
      ]
    },
    "ids.json": {
      "json": {
        "map": {
          "PAR-1": "<ID-1>"
        },
        "next_seqs": {
          "PAR": 2
        },
        "schema_version": 2
      }
    },
    "plans/<ID-1>.md": {
      "lines": [
        "# PAR-1: Flagged task"
      ]
    },
    "tasks/<ID-1>.json": {
      "json": {
        "acceptance_criteria": [],
        "assigned_to": null,
        "branch_links": [],
        "comment_count": 0,
        "complexity": null,
        "created_at": "<TS>",
        "created_by": "human:parity",
        "custom_fields": {},
        "description": null,
        "done_at": null,
        "evidence_refs": [],
        "id": "<ID-1>",
        "last_event_id": "<ID-7>",
        "last_status_changed_at": "<TS>",
        "linked_files": [],
        "needs_human": null,
        "priority": "medium",
        "relationships_out": [],
        "reopened_count": 0,
        "schema_version": 1,
        "short_id": "PAR-1",
        "status": "backlog",
        "tags": null,
        "title": "Flagged task",
        "type": "task",
        "updated_at": "<TS>",
        "urgency": null
      }
    }
  },
  "description": "needs-human set/clear, --file reasons, and the flag conflicts",
  "mode": "plain",
  "scenario": "flags",
  "steps": [
    {
      "args": [
        "init",
        "--path",
        "<ROOT>",
        "--actor",
        "human:parity",
        "--project-code",
        "PAR",
        "--no-setup-claude",
        "--no-setup-agents",
        "--no-seed"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "",
          ".lattice/ created — a mind now has a place to remember.",
          "Default actor: human:parity",
          "Project code: PAR",
          "Workflow statuses: stage11 (10 statuses)"
        ]
      }
    },
    {
      "args": [
        "create",
        "Flagged task",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "Created task PAR-1 (<ID-1>) \"Flagged task\"",
          "  status: backlog  priority: medium  type: task"
        ]
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "Need a call on the schema",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "needs_human set (PAR-1, status stays backlog)",
          "  Need: Need a call on the schema"
        ]
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "Asking again",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Task PAR-1 already has the needs_human flag set (by agent:worker since <TS>: Need a call on the schema). Clear it first with --clear."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "--clear",
        "--note",
        "Decided: dual-write",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "needs_human cleared (PAR-1)  Note: Decided: dual-write"
        ]
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "--clear",
        "--actor",
        "human:parity"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Task PAR-1 does not have the needs_human flag set."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "write_file": "reason.md"
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "--file",
        "<ROOT>/reason.md",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "needs_human set (PAR-1, status stays backlog)",
          "  Need: A long reason",
          "",
          "with `backticks`."
        ]
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "--clear",
        "--actor",
        "human:parity"
      ],
      "exit_code": 0,
      "stderr": {
        "lines": []
      },
      "stdout": {
        "lines": [
          "needs_human cleared (PAR-1)"
        ]
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: REASON is required when setting the needs_human flag. Say exactly what you need from the human, in one line (as an argument, or via --file)."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "Both",
        "--file",
        "<ROOT>/reason.md",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Provide either REASON or --file, not both."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "needs-human",
        "PAR-1",
        "Clear with reason",
        "--clear",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: REASON / --file is only for setting the flag. To clear, use --clear (optionally with --note)."
        ]
      },
      "stdout": {
        "lines": []
      }
    },
    {
      "args": [
        "needs-human",
        "NOPE-3",
        "Nowhere",
        "--actor",
        "agent:worker"
      ],
      "exit_code": 1,
      "stderr": {
        "lines": [
          "Error: Short ID 'NOPE-3' not found."
        ]
      },
      "stdout": {
        "lines": []
      }
    }
  ]
}
